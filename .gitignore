## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific files
*.user
*.userosscache
*.suo
*.userprefs
*.rsuser

# Auto-generated files
*.generated.*
*_i.c
*_p.c
*_h.h
*.dbmdl
*.jfm
*.cachefile
*.ide

# Visual Studio cache/options directory
.vs/
.vscode/

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
# Uncomment if you have local NuGet sources
# *.nupkg

# Tye
.tye/

# Microsoft Azure build output
csx/
*.build.csdef

#CLAUDE files
CLAUDE.local.md

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.log
*.vspscc
*.vssscc
*.vshost.*

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish outputs
publish/
app.publish/
out/
dist/

# dotenv / configuration
.env
.env.*

# Sensitive files (optional)
secrets.json

# Entity Framework
Migrations/
*.db
*.sqlite
*.mdf
*.ldf

# JetBrains Rider and Resharper
_ReSharper*/
*.DotSettings.user

# Coverage / analysis
*.coverage
*.coveragexml
*.dotCover
TestResults/
.coverage/
.coveragexml/
*.trx

# NPM or Yarn dependencies (if you use JS for frontend)
node_modules/
npm-debug.log
yarn-error.log

# Others
.DS_Store
Thumbs.db
